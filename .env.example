# ---- Django ----
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- PostgreSQL (docker-compose uses these as well) ----
DB_NAME=network_routes
DB_USER=network_user
DB_PASSWORD=network_password
DB_HOST=localhost
# Host port mapped to the container's 5432 (see docker-compose.yml)
DB_PORT=5433
